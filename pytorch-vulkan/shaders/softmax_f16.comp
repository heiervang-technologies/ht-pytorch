#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Fused softmax for float16 tensors. Computes in f32 for numerical stability,
// reads/writes f16.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Input { float16_t a[]; };
layout(set = 0, binding = 1) buffer Output { float16_t result[]; };

layout(push_constant) uniform PushConstants {
    uint outer_size;
    uint dim_size;
};

shared float sdata[256];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= outer_size) return;

    uint tid = gl_LocalInvocationID.x;
    uint base = row * dim_size;

    // Phase 1: Find max (compute in f32).
    float thread_max = -1.0 / 0.0;
    for (uint i = tid; i < dim_size; i += gl_WorkGroupSize.x) {
        thread_max = max(thread_max, float(a[base + i]));
    }
    sdata[tid] = thread_max;
    barrier();

    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) sdata[tid] = max(sdata[tid], sdata[tid + s]);
        barrier();
    }
    float row_max = sdata[0];
    barrier();

    // Phase 2: exp(x - max) and sum (compute in f32).
    float thread_sum = 0.0;
    for (uint i = tid; i < dim_size; i += gl_WorkGroupSize.x) {
        float val = exp(float(a[base + i]) - row_max);
        result[base + i] = float16_t(val);
        thread_sum += val;
    }
    sdata[tid] = thread_sum;
    barrier();

    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) sdata[tid] += sdata[tid + s];
        barrier();
    }
    float row_sum = sdata[0];
    barrier();

    // Phase 3: Normalize.
    float inv_sum = 1.0 / row_sum;
    for (uint i = tid; i < dim_size; i += gl_WorkGroupSize.x) {
        result[base + i] = float16_t(float(result[base + i]) * inv_sum);
    }
}
