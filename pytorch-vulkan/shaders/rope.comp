#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputX { float X[]; };
layout(set = 0, binding = 1) readonly buffer InputCos { float Cos[]; }; 
layout(set = 0, binding = 2) readonly buffer InputSin { float Sin[]; }; 
layout(set = 0, binding = 3) writeonly buffer OutputY { float Y[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
    uint D;
    uint S;
    uint H;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.num_elements) return;

    uint d_idx = idx % pc.D;
    uint half_D = pc.D / 2;
    
    if (d_idx < half_D) {
        uint s_idx = (idx / (pc.D * pc.H)) % pc.S;
        
        float x1 = X[idx];
        float x2 = X[idx + half_D];
        float c = Cos[s_idx * half_D + d_idx];
        float s = Sin[s_idx * half_D + d_idx];
        
        Y[idx] = x1 * c - x2 * s;
        Y[idx + half_D] = x1 * s + x2 * c;
    }
}
