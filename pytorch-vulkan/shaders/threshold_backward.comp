#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer GradOutput { float grad_output[]; };
layout(set = 0, binding = 1) buffer Input { float self_data[]; };
layout(set = 0, binding = 2) buffer Output { float result[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
    float threshold;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < num_elements) {
        result[idx] = self_data[idx] > threshold ? grad_output[idx] : 0.0;
    }
}
