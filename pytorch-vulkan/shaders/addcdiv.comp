#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer InputA { float a[]; };
layout(set = 0, binding = 1) readonly buffer InputB { float b[]; };
layout(set = 0, binding = 2) readonly buffer InputC { float c[]; };
layout(set = 0, binding = 3) writeonly buffer OutputD { float d[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
    float value;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pc.num_elements) {
        d[idx] = a[idx] + pc.value * (b[idx] / c[idx]);
    }
}