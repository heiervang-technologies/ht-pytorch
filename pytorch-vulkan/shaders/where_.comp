#version 450

// Element-wise conditional select: result[i] = cond[i] != 0.0 ? a[i] : b[i]
// Used in backward pass for masked gradient propagation.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Condition { float cond[]; };
layout(set = 0, binding = 1) buffer InputA { float a[]; };
layout(set = 0, binding = 2) buffer InputB { float b[]; };
layout(set = 0, binding = 3) buffer Output { float result[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < num_elements) {
        result[idx] = (cond[idx] != 0.0) ? a[idx] : b[idx];
    }
}
