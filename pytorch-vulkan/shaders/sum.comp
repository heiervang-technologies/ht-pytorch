#version 450

// Parallel reduction: computes the sum of all elements in the input buffer.
// Each workgroup reduces WORKGROUP_SIZE * 2 elements using shared memory,
// then atomically accumulates into the output buffer.
//
// Dispatch with: ceil(num_elements / (WORKGROUP_SIZE * 2)) workgroups.
// Output buffer must be zero-initialized before dispatch.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Input { float a[]; };
layout(set = 0, binding = 1) buffer Output { float result[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

shared float sdata[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;

    // Grid-stride loop: each thread accumulates multiple elements.
    float acc = 0.0;
    for (uint i = gid; i < num_elements; i += stride) {
        acc += a[i];
    }
    sdata[tid] = acc;

    barrier();

    // Tree reduction in shared memory.
    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) {
            sdata[tid] += sdata[tid + s];
        }
        barrier();
    }

    // Workgroup leader writes partial sum to output.
    // We use a simple output array indexed by workgroup ID.
    // A second pass (or CPU-side sum) combines these partial results.
    if (tid == 0) {
        result[gl_WorkGroupID.x] = sdata[0];
    }
}
