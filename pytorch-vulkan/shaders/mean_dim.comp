#version 450

// Dimension-aware reduction: mean along a single axis.
// Same as sum_dim but divides by reduce_size.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Input { float a[]; };
layout(set = 0, binding = 1) buffer Output { float result[]; };

layout(push_constant) uniform PushConstants {
    uint outer_size;
    uint reduce_size;
    uint inner_size;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_outputs = outer_size * inner_size;

    if (idx >= total_outputs) return;

    uint outer = idx / inner_size;
    uint inner = idx % inner_size;

    float acc = 0.0;
    uint base = outer * reduce_size * inner_size + inner;
    for (uint r = 0; r < reduce_size; r++) {
        acc += a[base + r * inner_size];
    }

    result[idx] = acc / float(reduce_size);
}
