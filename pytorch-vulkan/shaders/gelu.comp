#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputA {
    float A[];
};

layout(set = 0, binding = 1) writeonly buffer OutputC {
    float C[];
};

layout(push_constant) uniform PushConstants {
    uint num_elements;
} pc;

const float SQRT_2_OVER_PI = 0.7978845608028654;
const float COEF = 0.044715;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pc.num_elements) {
        float x = A[idx];
        float x3 = x * x * x;
        float inner = SQRT_2_OVER_PI * (x + COEF * x3);
        C[idx] = 0.5 * x * (1.0 + tanh(inner));
    }
}
