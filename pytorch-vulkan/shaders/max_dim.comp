#version 450

// Dimension-aware max reduction along a single axis.
// Needed for softmax (softmax = exp(x - max(x)) / sum(exp(x - max(x)))).

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Input { float a[]; };
layout(set = 0, binding = 1) buffer Output { float result[]; };

layout(push_constant) uniform PushConstants {
    uint outer_size;
    uint reduce_size;
    uint inner_size;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_outputs = outer_size * inner_size;

    if (idx >= total_outputs) return;

    uint outer = idx / inner_size;
    uint inner = idx % inner_size;

    uint base = outer * reduce_size * inner_size + inner;
    float max_val = a[base];
    for (uint r = 1; r < reduce_size; r++) {
        max_val = max(max_val, a[base + r * inner_size]);
    }

    result[idx] = max_val;
}
