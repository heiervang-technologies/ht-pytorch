#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Scores {
    float scores[];
};
layout(set = 0, binding = 1) readonly buffer Mask {
    uint mask_words[];
};

layout(push_constant) uniform PushConstants {
    uint num_elements;
    uint ndim;
    uint size0;
    uint size1;
    uint size2;
    uint size3;
    uint mask_size0;
    uint mask_size1;
    uint mask_size2;
    uint mask_size3;
    uint mask_stride0;
    uint mask_stride1;
    uint mask_stride2;
    uint mask_stride3;
    uint mask_offset;
} pc;

uint mask_index(uint index) {
    uint coordinate3 = index % pc.size3;
    index /= pc.size3;
    uint coordinate2 = index % pc.size2;
    index /= pc.size2;
    uint coordinate1 = index % pc.size1;
    uint coordinate0 = index / pc.size1;
    return pc.mask_offset +
        (pc.mask_size0 == 1 ? 0 : coordinate0) * pc.mask_stride0 +
        (pc.mask_size1 == 1 ? 0 : coordinate1) * pc.mask_stride1 +
        (pc.mask_size2 == 1 ? 0 : coordinate2) * pc.mask_stride2 +
        (pc.mask_size3 == 1 ? 0 : coordinate3) * pc.mask_stride3;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.num_elements) {
        return;
    }
    uint source = mask_index(index);
    uint shift = (source % 4) * 8;
    bool keep = ((mask_words[source / 4] >> shift) & 0xff) != 0;
    if (!keep) {
        scores[index] = -1.0 / 0.0;
    }
}
