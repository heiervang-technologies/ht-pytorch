#version 450
#extension GL_EXT_shader_atomic_float : enable

// Flash Attention 2 Forward Pass
//
// Computes: O = softmax(Q @ K^T / sqrt(d)) @ V
// Saves: LSE = m + log(l) per query row for backward pass
//
// Uses tiled online softmax to avoid materializing N×N attention matrix.
// Each workgroup processes TILE_Q=32 query rows over all K/V tiles.
//
// Dispatch: (ceil(seq_len / TILE_Q), batch * heads, 1)

layout(local_size_x = 32, local_size_y = 1) in;

layout(set = 0, binding = 0) buffer QueryBuf  { float q_data[]; };
layout(set = 0, binding = 1) buffer KeyBuf    { float k_data[]; };
layout(set = 0, binding = 2) buffer ValueBuf  { float v_data[]; };
layout(set = 0, binding = 3) buffer OutBuf    { float o_data[]; };
layout(set = 0, binding = 4) buffer LseBuf    { float lse_data[]; };

layout(push_constant) uniform PushConstants {
    uint seq_len;
    uint d_k;
    uint d_v;
    float scale;
};

// Tile sizes
const uint TILE_Q = 32;
const uint TILE_K = 32;

// Shared memory
shared float s_S[TILE_Q][TILE_K];  // score tile

void main() {
    uint q_tile_idx = gl_WorkGroupID.x;     // which Q tile
    uint head_idx = gl_WorkGroupID.y;       // which batch*head
    uint tid = gl_LocalInvocationID.x;      // thread within tile [0, TILE_Q)

    uint q_row = q_tile_idx * TILE_Q + tid; // global query row
    if (q_row >= seq_len) return;

    uint q_base = head_idx * seq_len * d_k + q_row * d_k;
    uint o_base = head_idx * seq_len * d_v + q_row * d_v;
    uint lse_idx = head_idx * seq_len + q_row;

    // Initialize output accumulator and online softmax state.
    float m_i = -1.0 / 0.0;  // -inf
    float l_i = 0.0;

    // Per-thread output accumulator (one row of O, length d_v).
    // We accumulate in registers since d_v fits (up to 128).

    // Process all K/V tiles.
    uint num_k_tiles = (seq_len + TILE_K - 1) / TILE_K;

    for (uint kt = 0; kt < num_k_tiles; kt++) {
        // Phase 1: Compute S_ij = Q[q_row] . K[k_col] * scale for this tile.
        uint k_start = kt * TILE_K;

        // Each thread computes its dot product with all K rows in this tile.
        // But we only have TILE_Q threads, and TILE_K keys to process.
        // Since TILE_Q == TILE_K == 32, thread tid computes score for k_col = tid.
        float score = -1.0 / 0.0;
        uint k_col = k_start + tid;
        if (k_col < seq_len) {
            uint k_base = head_idx * seq_len * d_k + k_col * d_k;
            float dot = 0.0;
            for (uint i = 0; i < d_k; i++) {
                dot += q_data[q_base + i] * k_data[k_base + i];
            }
            score = dot * scale;
        }

        // Store scores in shared memory.
        // Note: each thread stores one score, but we need all threads' scores
        // for the softmax. Use shared memory row = tid (the query), col varies.
        // Actually with TILE_Q == TILE_K == 32 and one thread per Q row,
        // we need each thread to compute ALL TILE_K scores for its query row.

        // Rewrite: each thread handles one query row and computes all K scores.
        float local_max = -1.0 / 0.0;
        float local_sum = 0.0;

        for (uint kk = 0; kk < TILE_K; kk++) {
            uint k_idx = k_start + kk;
            if (k_idx >= seq_len) break;

            uint k_base = head_idx * seq_len * d_k + k_idx * d_k;
            float dot = 0.0;
            for (uint i = 0; i < d_k; i++) {
                dot += q_data[q_base + i] * k_data[k_base + i];
            }
            float s = dot * scale;
            s_S[tid][kk] = s;
            local_max = max(local_max, s);
        }

        // Online softmax update.
        float m_new = max(m_i, local_max);

        // Compute exp(s - m_new) and sum for this tile.
        float tile_sum = 0.0;
        for (uint kk = 0; kk < TILE_K; kk++) {
            uint k_idx = k_start + kk;
            if (k_idx >= seq_len) break;
            s_S[tid][kk] = exp(s_S[tid][kk] - m_new);
            tile_sum += s_S[tid][kk];
        }

        // Rescale previous accumulator.
        float alpha = exp(m_i - m_new);
        float l_new = alpha * l_i + tile_sum;

        // Update output: O = (alpha * l_i / l_new) * O_old + (1/l_new) * P_tile @ V_tile
        // We handle this by rescaling existing output and adding new contribution.
        float rescale = (l_i > 0.0) ? (alpha * l_i / l_new) : 0.0;
        float new_weight = 1.0 / l_new;

        for (uint d = 0; d < d_v; d++) {
            float o_old = (kt == 0) ? 0.0 : o_data[o_base + d];
            float o_new = rescale * o_old;

            // Add P_tile @ V_tile contribution for this output element.
            float pv = 0.0;
            for (uint kk = 0; kk < TILE_K; kk++) {
                uint k_idx = k_start + kk;
                if (k_idx >= seq_len) break;
                uint v_base = head_idx * seq_len * d_v + k_idx * d_v;
                pv += s_S[tid][kk] * v_data[v_base + d];
            }
            o_data[o_base + d] = o_new + new_weight * pv;
        }

        m_i = m_new;
        l_i = l_new;
    }

    // Save LSE = m + log(l) for backward pass.
    lse_data[lse_idx] = m_i + log(l_i);
}
