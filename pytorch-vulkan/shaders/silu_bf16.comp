#version 450

// Each thread processes TWO elements (one full uint32) to avoid atomic contention.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Input { uint a[]; };
layout(set = 0, binding = 1) writeonly buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

float bf16_to_f32(uint bf16_val) {
    uint u32_val = bf16_val << 16;
    return uintBitsToFloat(u32_val);
}

uint f32_to_bf16(float f32_val) {
    uint u = floatBitsToUint(f32_val);
    uint r = u + 0x7FFF + ((u >> 16) & 1);
    return r >> 16;
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    
    // Each thread handles 2 elements.
    uint start_idx = tid * 2;
    
    if (start_idx < num_elements) {
        uint word = a[tid];
        
        // Lower 16 bits
        uint val_lo = word & 0xFFFF;
        float x_lo = bf16_to_f32(val_lo);
        float s_lo = x_lo / (1.0 + exp(-x_lo));
        uint r_lo = f32_to_bf16(s_lo);
        
        uint packed = r_lo;
        
        // Upper 16 bits
        if (start_idx + 1 < num_elements) {
            uint val_hi = (word >> 16) & 0xFFFF;
            float x_hi = bf16_to_f32(val_hi);
            float s_hi = x_hi / (1.0 + exp(-x_hi));
            uint r_hi = f32_to_bf16(s_hi);
            packed |= (r_hi << 16);
        }
        
        result[tid] = packed;
    }
}
