#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer GradOutput {
    float16_t grad_output[];
};
layout(set = 0, binding = 1) readonly buffer Input {
    float16_t input_data[];
};
layout(set = 0, binding = 2) writeonly buffer GradInput {
    float16_t grad_input[];
};

layout(push_constant) uniform PushConstants {
    uint num_elements;
    float threshold;
};

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < num_elements) {
        grad_input[index] = float(input_data[index]) <= threshold
            ? float16_t(0.0)
            : grad_output[index];
    }
}
