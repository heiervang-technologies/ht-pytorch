#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Input { uint a[]; };
layout(set = 0, binding = 1) buffer Output { uint result[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < num_elements) {
        uint a_word = a[idx / 2];
        uint shift = (idx % 2) * 16;
        uint a_val = (a_word >> shift) & 0xFFFF;
        atomicOr(result[idx / 2], a_val << shift);
    }
}
