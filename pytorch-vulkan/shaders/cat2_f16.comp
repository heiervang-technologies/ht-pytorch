#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer InputA { float16_t a[]; };
layout(set = 0, binding = 1) readonly buffer InputB { float16_t b[]; };
layout(set = 0, binding = 2) writeonly buffer Output { float16_t result[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
    uint inner_a;
    uint inner_b;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= num_elements) return;

    uint inner_total = inner_a + inner_b;
    uint outer_idx = idx / inner_total;
    uint inner_idx = idx % inner_total;

    if (inner_idx < inner_a) {
        result[idx] = a[outer_idx * inner_a + inner_idx];
    } else {
        result[idx] = b[outer_idx * inner_b + (inner_idx - inner_a)];
    }
}
