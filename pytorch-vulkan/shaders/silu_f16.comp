#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Input { float16_t a[]; };
layout(set = 0, binding = 1) buffer Output { float16_t result[]; };

layout(push_constant) uniform PushConstants {
    uint num_elements;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < num_elements) {
        float x = float(a[idx]);
        result[idx] = float16_t(x / (1.0 + exp(-x)));
    }
}
